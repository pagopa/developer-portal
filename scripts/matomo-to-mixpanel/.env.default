# Optional: the uploader defaults to the EU ingestion endpoint.
MIXPANEL_API_HOST=https://api-eu.mixpanel.com

# Option 1: project token (Basic Auth username; empty password).
MIXPANEL_PROJECT_TOKEN=

# Option 2: Owner/Admin service account. Leave the project token empty.
MIXPANEL_SERVICE_ACCOUNT_USERNAME=
MIXPANEL_SERVICE_ACCOUNT_SECRET=
MIXPANEL_PROJECT_ID=
