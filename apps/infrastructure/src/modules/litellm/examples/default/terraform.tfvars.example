region = "eu-west-1"
azs    = ["eu-west-1a", "eu-west-1b"]
tenant = "acme"
env    = "dev"

gateway_image = "docker.litellm.ai/berriai/litellm:main-stable"

# Daily shutdown/startup in Italian local time (CET/CEST), including weekends.
gateway_scheduled_scaling_enabled = true

# Existing networking (private subnets need NAT for the public image registry).
# vpc_id             = "vpc-0123456789abcdef0"
# public_subnet_ids  = ["subnet-public-a", "subnet-public-b"]
# private_subnet_ids = ["subnet-private-a", "subnet-private-b"]
# additional_task_security_group_ids = ["sg-0123456789abcdef0"]

# Defaults create Aurora and Redis. DATABASE_URL is generated from the Aurora
# credentials and stored in Secrets Manager, never in the task definition.
create_database = true
create_redis    = true

# Alternatively, use an existing secret containing the full PostgreSQL URL.
# The hostname must be reachable from ECS; "db" is a Docker Compose name only.
# create_database         = false
# database_url_secret_arn = "arn:aws:secretsmanager:eu-west-1:111122223333:secret:litellm-db-AbCdEf"
# For a JSON secret, append :DATABASE_URL:: to select that field.
# Or supply the URL with TF_VAR_database_url; Terraform stores it in a secret.

# For an existing Redis, set create_redis = false and supply TF_VAR_redis_url
# (rediss:// for TLS). Its security group must allow the ECS tasks on 6379.

# ACM DNS validation and the litellm.<zone-name> CNAME are created by default.
hosted_zone_id = "Z02428843GXDP0RBGX2EQ"
# acm_certificate_arn = "arn:aws:acm:eu-west-1:111122223333:certificate/existing"
# allow_plaintext_alb = true # HTTP-only, for temporary development environments

# Prefer TF_VAR_litellm_master_key / TF_VAR_ui_password for login secrets.
# Otherwise the module generates a master key; the UI uses it by default.

# Merge any model definitions into this config. Redis coordinates the router
# and the proxy cache; setting REDIS_HOST alone is not sufficient.
proxy_config = {
  router_settings = {
    redis_host = "os.environ/REDIS_HOST"
    redis_port = "os.environ/REDIS_PORT"
  }
  litellm_settings = {
    cache = true
    cache_params = {
      type = "redis"
    }
  }
}

# These now apply to the same container, including UI and management settings.
# gateway_extra_env = {
#   UI_USERNAME = "admin"
#   DOCS_TITLE  = "LiteLLM"
# }
# gateway_extra_secrets = {
#   OPENAI_API_KEY = "arn:aws:secretsmanager:eu-west-1:111122223333:secret:openai-api-key-AbCdEf"
# }

# Only enable for disposable environments where losing stored data is acceptable.
# s3_force_destroy    = true
# skip_final_snapshot = true
