# chatbot-index settings shared by the indexer container and the LocalStack lambda.
# The S3 bucket name and the AWS endpoint are set in compose.yaml.

CHB_INDEX_ID=devportal-index
CHB_REDIS_URL=redis://redis:6379
# The S3 data and the sitemap come from the dev bucket
CHB_WEBSITE_URL=https://dev.developer.pagopa.it
CHB_LANGUAGE_CODE_STATIC_FILES=it

# Mock models: no Google credentials and no costs.
# MockEmbedding has 5 dimensions, so the Redis schema must use the same value.
CHB_PROVIDER=mock
CHB_EMBEDDING_DIM=5
# Created in LocalStack by the init script with an empty service account
CHB_AWS_SSM_GOOGLE_SERVICE_ACCOUNT=/local/google_service_account
CHB_EMBED_MODEL_ID=gemini-embedding-001
CHB_EMBED_BATCH_SIZE=100
CHB_EMBED_RETRIES=30
CHB_EMBED_RETRY_MIN_SECONDS=1.5
CHB_MODEL_ID=gemini-2.5-flash-lite
CHB_MODEL_MAXTOKENS=2048
CHB_MODEL_TEMPERATURE=0.3
